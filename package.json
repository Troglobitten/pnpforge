{
  "name": "pnpforge",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hosted workshop and virtual tabletop for solo print-and-play games",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "cross-env": "^10.1.0",
    "fastify": "^5.12.4",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "immer": "^11.1.18",
    "lucide-react": "^1.45.0",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "tsx": "^4.23.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Troglobitten/pnpforge.git"
  },
  "homepage": "https://github.com/Troglobitten/pnpforge",
  "bugs": {
    "url": "https://github.com/Troglobitten/pnpforge/issues"
  },
  "keywords": [
    "print-and-play",
    "boardgames",
    "solo",
    "virtual-tabletop",
    "self-hosted",
    "pnp"
  ]
}
